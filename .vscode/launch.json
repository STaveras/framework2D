{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "C++ Launch (Windows)",
            "type": "cppvsdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/cmake-windows-debug/Debug/MyProject.exe",
            "args": [],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}/bin",
            "environment": [],
            "console": "externalTerminal",
            "preLaunchTask": "CMake: build (windows-debug)",
        },
        {
            "name": "clang++ - Debug program (mac, opengl)",
            // "type": "cppdbg",
            "type": "lldb",
            "request": "launch",
            "program": "${workspaceFolder}/bin/${workspaceFolderBasename}_d",
            "args": ["--debug", "--opengl", "--fps", "--dbg-collision", "--static-bg"],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}/bin",
            "environment": [{ "name": "config", "value": "Debug" }],
            "externalConsole": false,
            "MIMode": "lldb",
            "targetArchitecture":"arm64",
            "preLaunchTask": "Make (macOS, debug)"
        },
        {
            "name": "clang++ - Debug program (mac, metal)",
            // "type": "cppdbg",
            "type": "lldb",
            "request": "launch",
            "program": "${workspaceFolder}/bin/${workspaceFolderBasename}_d",
            "args": ["--debug", "--metal", "--fps"],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}/bin",
            "environment": [],
            "externalConsole": false,
            "MIMode": "lldb",
            "targetArchitecture":"arm64",
            "preLaunchTask": "Make (macOS, debug)"
        },
        {
            "name": "clang++ - Debug program (mac, vulkan)",
            // "type": "cppdbg",
            "type": "lldb",
            "request": "launch",
            "program": "${workspaceFolder}/bin/${workspaceFolderBasename}_d",
            "args": ["--debug", "--vulkan", "--fps"],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}/bin",
            "environment": [{ "name": "config", "value": "Debug" }],
            "externalConsole": false,
            "MIMode": "lldb",
            "targetArchitecture":"arm64",
            "preLaunchTask": "Make (macOS, debug)"
        }
    ]
}
