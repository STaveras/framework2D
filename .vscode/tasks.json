{
    "tasks": [
        {
            "label": "Make (macOS, debug)",
            "type": "shell",
            "command": "bash",
            "args": [
                "-lc",
                "make -j$(sysctl -n hw.ncpu) DEBUG=1"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": [
                "$gcc"
            ]
        },
        {
            "label": "Make (macOS, release)",
            "type": "shell",
            "command": "bash",
            "args": [
                "-lc",
                "make -j$(sysctl -n hw.ncpu)"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": {
                "kind": "build",
                "isDefault": false
            },
            "problemMatcher": [
                "$gcc"
            ]
        },
        {
            "label": "Make Clean",
            "type": "shell",
            "command": "make",
            "args": [
                "clean"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": {
                "kind": "build",
                "isDefault": false
            },
            "problemMatcher": []
        },
        {
            "label": "Build Project",
            "type": "shell",
            "command": "cmake --build ${workspaceFolder}/build",
            "group": {
                "kind": "build",
                "isDefault": false
            },
            "problemMatcher": []
        },
        {
            "type": "cppbuild",
            "label": "C/C++: cl.exe build active file (Windows)",
            "command": "cl.exe",
            "args": [
                "/Zi",
                "/EHsc",
                "/nologo",
                "/Fe${workspaceFolder}\\bin\\${workspaceFolderBasename}.exe",
                "${file}"
            ],
            "options": {
                "cwd": "${fileDirname}"
            },
            "problemMatcher": [
                "$msCompile"
            ],
            "group": {
                "kind": "build",
                "isDefault": false
            },
            "detail": "Task generated by Debugger."
        },
        {
            "type": "shell",
            "label": "Build (macOS, debug)",
            "command": "./utl/post-build.sh",
            "group": {
                "kind": "build",
                "isDefault": false
            },
            "dependsOn": [
                "C/C++: clang++ build project (macOS, debug)"
            ],
            "problemMatcher": []
        },
        {
            "type": "shell",
            "label": "Compile shaders using glslc",
            "command": "./utl/compile-shaders.sh",
            "windows": {
                "command": ".\\utl\\compile-shaders.bat"
            },
            "group": {
                "kind": "build",
                "isDefault": false
            },
            "options": {
                "cwd": "${fileDirname}"
            }
        },
        {
            "type": "cppbuild",
            "label": "C/C++: cl.exe build active file",
            "command": "cl.exe",
            "args": [
                "/Zi",
                "/EHsc",
                "/nologo",
                "/Fe${fileDirname}\\${fileBasenameNoExtension}.exe",
                "${file}"
            ],
            "options": {
                "cwd": "${fileDirname}"
            },
            "problemMatcher": [
                "$msCompile"
            ],
            "group": {
                "kind": "build",
                "isDefault": false
            },
            "detail": "Task generated by Debugger."
        },
        {
            "type": "cmake",
            "label": "CMake: configure (windows-debug)",
            "command": "configure",
            "preset": "windows-debug",
            "problemMatcher": []
        },
        {
            "type": "cmake",
            "label": "CMake: build (windows-debug)",
            "command": "build",
            "preset": "windows-debug",
            "group": {
                "kind": "build",
                "isDefault": false
            },
            "dependsOn": [
                "CMake: configure (windows-debug)"
            ],
            "problemMatcher": [],
            "detail": "CMake template build task"
        }
    ],
    "version": "2.0.0"
}
